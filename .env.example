# PostgreSQL connection string from Neon (required).
DATABASE_URL=

# Gemini API key from Google AI Studio.
AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Resend settings for live email delivery.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=

# Maximum article age in hours.
MAX_ARTICLE_AGE_HOURS=25

# Maximum number of stories in a digest.
TOP_ARTICLES_COUNT=8
