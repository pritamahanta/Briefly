{
  "name": "daily-tech-news-agent",
  "version": "1.0.0",
  "description": "A daily tech news digest agent.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test:db": "node --network-family-autoselection-attempt-timeout=2000 scripts/check-db.js",
