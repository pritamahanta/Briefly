{
  "name": "briefly",
  "version": "1.0.0",
  "description": "A daily tech news digest, summarized by Gemini and emailed through Resend.",
  "type": "module",
  "scripts": {
    "test": "node test/agent.test.js",
    "build": "node scripts/build.js",
    "test:db": "node --network-family-autoselection-attempt-timeout=2000 scripts/check-db.js",
    "start": "node --network-family-autoselection-attempt-timeout=2000 src/worker.js",
    "send": "node --network-family-autoselection-attempt-timeout=2000 src/worker.js --send",
    "dev": "node --network-family-autoselection-attempt-timeout=2000 --watch src/worker.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.147",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "ai": "^6.0.333",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "resend": "^6.38.1",
    "rss-parser": "^3.13.0"
  }
}
